# Painel do dono. Nada disso entra no navegador de quem só visita o site.
SETUP_TOKEN=
SESSION_SECRET=
PAINEL_URL=http://127.0.0.1:8787
PAINEL_SEGURO=0
PAINEL_PROXY=0
PORT=8787

# Correio do código e do link de senha. Use SMTP ou Resend, um dos dois.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

RESEND_API_KEY=

# Tradução automática: deepl, google ou anthropic. Sem chave, o texto fica pendente.
TRADUCAO_PROVEDOR=
TRADUCAO_CHAVE=
TRADUCAO_MODELO=claude-sonnet-4-5
DEEPL_URL=https://api-free.deepl.com/v2/translate

# Limites de subida, em bytes.
UPLOAD_IMAGEM_MAX=8388608
UPLOAD_VIDEO_MAX=83886080

# Custo do bcrypt. Em produção deixe 12.
BCRYPT_ROUNDS=12
