{
  "name": "trail-sanctuary-site",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio estático accesible del santuario: 3 páginas en 6 idiomas, sin dependencias.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "check": "node build.mjs && node scripts/check.mjs",
    "painel": "node painel/servidor.mjs",
    "test:painel": "node --test painel/testes/critico.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "nodemailer": "^7.0.10",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
